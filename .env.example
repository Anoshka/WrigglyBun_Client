# Copy to `.env.local` for local draft preview (optional).
# Only set these on the **view/staging** Netlify site — NOT on www.wrigglybunphotography.com.

# Shared secret — Presentation uses this to turn preview on (pick a long random string).
VITE_SANITY_PREVIEW_SECRET=your-long-random-secret-here

# Sanity **Viewer** (read) API token — lets the site fetch unpublished drafts.
# Create at https://www.sanity.io/manage → API → Tokens → Viewer
VITE_SANITY_PREVIEW_TOKEN=

# Deployed Studio URL (used for click-to-edit overlays in Presentation)
VITE_SANITY_STUDIO_URL=https://wrigglybun.sanity.studio
